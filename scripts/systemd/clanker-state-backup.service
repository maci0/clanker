[Unit]
Description=Back up clanker runtime-local data

[Service]
Type=oneshot
# A user service inherits the manager's environment, not the login shell's, so
# an export in a shell profile never reaches the timer. The file is the one
# place the service reads its configuration from; `-` keeps a missing file
# from failing the unit (every setting has a default in backup-state.sh).
EnvironmentFile=-%h/.config/clanker/backup.env
# `Type=oneshot` disables TimeoutStartSec by default, so a run wedged on an
# unanswered mount (an off-site destination that stopped answering) never
# exits, never fails, and the timer reports `active` for the whole outage.
# Twice the timer interval: a real backup of a multi-gigabyte store takes
# minutes, so exceeding this means the run is not going to finish.
TimeoutStartSec=1h
# A snapshot carries config.local.toml and .env, so nothing it creates should
# be readable by anyone but its owner: 0077 is the umask the installer already
# writes backup.env through, so a scheduled run and an interactive run produce
# the same modes rather than the login shell's 022 deciding for one of them.
# `rsync -a` sets each restored file's mode from its source, so this only
# covers what the run creates itself (staging directories, a recreated wal
# sidecar, the drill's scratch copy), never what it copies.
UMask=0077
# The run shells out to rsync, sqlite3 and (for a remote mirror) ssh. None of
# them needs privilege to gain, so refuse the whole tree the ability rather
# than trusting the call graph of a script that reads operator-edited paths.
NoNewPrivileges=true
ExecStart=%h/.local/bin/clanker-state-backup
