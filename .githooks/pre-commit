#!/bin/sh
# Pre-commit checks over staged files only. Fast by design: the slow gates
# (build, tests, e2e) belong to `clanker gate` and CI, not to every commit.
# Enable once per clone:
#     git config core.hooksPath .githooks
# Bypass for a work-in-progress commit: git commit --no-verify
set -eu

fail() {
    echo "pre-commit: $1" >&2
    exit 1
}

staged() {
    git diff --cached --name-only --diff-filter=ACMR -z -- "$@"
}

# Conflict markers in any staged file. Matched at line start on added lines
# only, so committing this hook (or docs quoting a marker mid-line) passes.
if git diff --cached --unified=0 | grep -qE '^\+(<{7}( |$)|={7}$|>{7}( |$))'; then
    fail "staged changes contain merge conflict markers"
fi

# Obvious credentials in added lines. Narrow, known prefixes only, so a
# false positive stays rare; --no-verify is the escape hatch for docs that
# must quote one.
if git diff --cached --unified=0 | grep -qE '^\+.*(sk-ant-[a-zA-Z0-9_-]{8}|ghp_[A-Za-z0-9]{20}|github_pat_[A-Za-z0-9_]{20}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'; then
    fail "staged changes look like they contain a credential (bypass: --no-verify)"
fi

# Zig formatting. `zig fmt --check` also fails on syntax errors, so this
# doubles as a parse check.
#
# `zig` comes off PATH, so the version is checked against the one
# build.zig.zon pins before it formats anything: build.zig refuses to
# configure against anything but 0.16.x, and a hook that ran a different
# compiler would rewrite files to whatever that version calls canonical.
if [ -n "$(staged '*.zig' | tr -d '\0')" ]; then
    if ! command -v zig >/dev/null 2>&1; then
        fail "zig is not on PATH; this check formats with the compiler, and build.zig.zon pins which one"
    fi
    required_zig=$(sed -n 's/^[[:space:]]*\.minimum_zig_version[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' build.zig.zon | head -n1)
    if [ -z "$required_zig" ]; then
        fail "build.zig.zon has no .minimum_zig_version to check zig against"
    fi
    have_zig=$(zig version)
    case "$have_zig" in
        "$required_zig" | "$required_zig"*) ;;
        *) fail "zig on PATH is $have_zig, but build.zig.zon pins $required_zig" ;;
    esac
    staged '*.zig' | xargs -0 zig fmt --check ||
        fail "zig fmt --check failed (fix: zig fmt <files above>)"
fi

# Shell scripts, when shellcheck is installed (CI runs it regardless). This
# hook is a tracked shell script with no .sh suffix and nothing runs it in CI
# except the `git ls-files '*.sh' '.githooks/pre-commit'` step, so it is named
# here too: a hook that lints every other script but not itself is the one
# script whose failures stay invisible until CI reads the tree.
if command -v shellcheck >/dev/null 2>&1; then
    if [ -n "$(staged '*.sh' '.githooks/pre-commit' | tr -d '\0')" ]; then
        staged '*.sh' '.githooks/pre-commit' | xargs -0 shellcheck || fail "shellcheck failed"
    fi
fi

# YAML, when yamllint is installed (CI runs it regardless). Same
# .yamllint.yml and same defect rules as CI's "Check YAML" step: a workflow
# that does not parse, or one carrying a duplicated key (the last duplicate
# silently wins), is caught here rather than by a red X on someone else's PR.
# .yamllint.yml is itself a staged trigger, since it is what the check reads.
if command -v yamllint >/dev/null 2>&1; then
    if [ -n "$(staged '*.yml' '*.yaml' '.yamllint.yml' | tr -d '\0')" ]; then
        staged '*.yml' '*.yaml' | xargs -0 -r yamllint -c .yamllint.yml || fail "yamllint failed"
    fi
fi

# Brand outputs, when bun is installed: docs/brand/ and the favicon and
# masthead in ui/app/index.html are generated from the tokens and the icon
# grid, so a change to either must carry its regenerated files.
if [ -n "$(staged 'docs/brand/*' 'ui/app/index.html' 'ui/app/tailwind.src.css' 'ui/app/core/icons.js' 'scripts/brand.ts' | tr -d '\0')" ] && command -v bun >/dev/null 2>&1; then
    bun scripts/brand.ts --check || fail "brand outputs are stale (run: bun scripts/brand.ts)"
fi

# Python lint, when ruff is installed (CI runs it regardless). Same config
# (ruff.toml) and same file set as CI: every tracked .py, globbed from the
# index by the caller. `required-version` in ruff.toml is what keeps a ruff
# from another release off both sides: it names the version CI installs, so a
# PATH ruff that disagrees refuses to run rather than verifying a rule set
# CI never ran.
if command -v ruff >/dev/null 2>&1; then
    if [ -n "$(staged '*.py' | tr -d '\0')" ]; then
        staged '*.py' | xargs -0 ruff check || fail "ruff check failed"
    fi
fi

# JavaScript lint, when the root toolchain is installed (`bun install`; CI runs it
# regardless). The same command as CI: `bun run lint` runs every rule at error
# over the whole tree (about 3s) and fails when a file's count for a rule moves
# off tools/oxlint/baseline.json, or a disable directive silences nothing.
if [ -n "$(staged '*.js' '*.mjs' '*.ts' 'tools/oxlint/baseline.json' '.oxlintrc.json' 'tsconfig.json' | tr -d '\0')" ]; then
    # A fresh clone or worktree has no node_modules; the lint toolchain is a
    # declared, lockfile-pinned dependency, so install it rather than skip:
    # skipping let commits from dependency-less worktrees reach CI unlinted.
    if [ ! -x node_modules/.bin/oxlint ] && command -v bun >/dev/null 2>&1; then
        bun install --frozen-lockfile >/dev/null || fail "bun install --frozen-lockfile failed; the JS lint toolchain is not available"
    fi
    if [ -x node_modules/.bin/oxlint ]; then
        bun run lint || fail "lint ratchet failed (fix the finding; bun run lint:baseline records paid-down debt)"
        # The same check CI runs, on the whole program tsconfig.json names (a
        # staged file is not the only one a type error can appear in, so the
        # per-file scoping the fmt check above uses would answer a different
        # question than CI's answer to the same tree).
        bun run typecheck || fail "tsc --noEmit failed"
    else
        echo "pre-commit: skipping JavaScript lint, bun is not installed (CI runs it)" >&2
    fi
fi

# Tool manifests, when a built clanker is present. The same validation runs
# as a unit test in CI, so a missing binary is a skip, not a failure.
if [ -x zig-out/bin/clanker ]; then
    if [ -n "$(staged 'tools/manifests/*.tool.json' | tr -d '\0')" ]; then
        staged 'tools/manifests/*.tool.json' | xargs -0 -n1 zig-out/bin/clanker plugins validate ||
            fail "manifest validation failed"
    fi
fi

exit 0
