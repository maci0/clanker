**.ignore

# Zig build artifacts
.zig-cache/
zig-out/
zig-pkg/

# AssemblyScript toolchain and its build output (tools/ts/dist/ IS committed)
tools/ts/node_modules/
tools/ts/build/

# The kernel tool's WASI-sandboxed CPython interpreter (~25 MB), fetched by
# scripts/setup-python-wasi.sh. Not committed: most checkouts never enable
# agent.kernel, and the release tarball is sha256-pinned in that script.
/vendor/python-wasi/

# Runtime state (logs, history, sessions, improvements) — never commit.
# No trailing slash: isolated runs use a state symlink, which Git otherwise
# treats as a file and can accidentally stage.
/state

# Isolated git worktrees improve-self runs stage themselves in
.clanker-worktrees/

# User-local configuration (API keys live in env vars anyway)
config.local.json
config.local.toml

# User-local project agent instructions. No trailing slash: this can be a
# symlink and must not be stageable as a regular Git entry.
/.agents

# User-local Claude project rules (e.g. symlink into .agents/)
.claude/

# User-local Grok project rules (e.g. symlink into .agents/)
.grok/

# User-local agent coordination and machine state (task board, locks, scratch).
# No trailing slash: this can be a symlink and must not be stageable as a
# regular Git entry.
/.local

# Editor / OS junk
.DS_Store
*.swp
*~
.env

# Local run artifacts (backups, logs, scratch output)
*.bak
*.log
*.out
run.json
chatrooms.jsonl

# tree-sitter grammars built by tools/grammars/build.sh
tools/grammars/*.so
.playwright-mcp/

# Runtime lock for the self-improvement review loop.
.review-loop.lock

# Sidecar locks the sandbox's compare-and-swap write (fs_write_if) creates next
# to the file it rewrites. Left in place on purpose — unlinking would race a
# concurrent acquirer — so they accumulate anywhere an agent edits a file.
# No leading slash: they appear beside their target, at any depth.
*.ck_cas.lock

.semcode.db/
