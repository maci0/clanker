# Zig build artifacts
.zig-cache/
zig-out/
zig-pkg/

# AssemblyScript toolchain and its build output (tools/bin/ IS committed)
tools/ts/node_modules/
tools/ts/build/

# Runtime state (logs, history, sessions, improvements) — never commit
state/

# User-local configuration (API keys live in env vars anyway)
config.local.json

# User-local project agent instructions
.agents/

# User-local Claude project rules (e.g. symlink into .agents/)
.claude/

# User-local agent coordination and machine state (task board, locks, scratch)
.local/

# Editor / OS junk
.DS_Store
*.swp
*~
.env

# Local run artifacts (backups, logs, scratch output)
*.bak
*.log
run.json
chatrooms.jsonl

# tree-sitter grammars built by tools/grammars/build.sh
tools/grammars/*.so
.playwright-mcp/

# Runtime lock for the self-improvement review loop.
.review-loop.lock

**.ignore