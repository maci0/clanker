{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["tools/oxlint/*.ts", "ui/**/*.js", "ui/**/*.mjs", "ui/**/*.ts"],
  "exclude": ["node_modules", "ui/vendor", "tools/oxlint/anti-slop"]
}
