# Copy to .env and fill in the keys for the providers you use (config.toml
# "api_key_env"). clanker loads it automatically when modules.dotenv is on;
# real environment variables always take precedence over this file.

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
META_AI_API_KEY=
OPENROUTER_API_KEY=
KIMI_API_KEY=
GOOGLE_API_KEY=           # providers.google (Gemini AI Studio)
NVIDIA_API_KEY=           # providers.nvidia (NVIDIA build)

# vllm-local and ollama run unauthenticated by default and need no key.

# Optional clanker process overrides (see docs/README.md):
# CLANKER_ENV_FILE=.env
# CLANKER_LOG_LEVEL=info
# CLANKER_HOST=127.0.0.1
# CLANKER_WEBUI_PORT=17921
# CLANKER_PROXY_PORT=17922
# CLANKER_PROXY_TOKEN=          # when [serve].proxy uses proxy_token_env
# CLANKER_THEME=mocha
# CLANKER_DEBUG_BODY=1          # logs request metadata only, never bodies
