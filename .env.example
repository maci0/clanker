# Copy to .env and fill in the keys for the providers you use (config.toml
# "api_key_env"). clanker loads it automatically when modules.dotenv is on;
# real environment variables always take precedence over this file.
#
# Keep values bare and put notes on their own line: an unquoted value ends
# at a "# " that whitespace introduces, so "KEY=value  # note" would load
# the note as part of the value. A line that is not KEY=VALUE, one with an
# empty key, and a value that opens a quote it never closes are each skipped
# with a warning naming the file and line; every other key still loads.

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
META_AI_API_KEY=
KIMI_API_KEY=

# Not read by config.toml as shipped: OpenRouter is reached by adding your own
# [providers.openrouter] stanza (kind = "openai_compat",
# base_url = "https://openrouter.ai/api/v1", api_key_env = "OPENROUTER_API_KEY"),
# and the key below is only used once that stanza names it. An empty value here
# means "no key", not the empty key.
OPENROUTER_API_KEY=

# providers.google (Gemini AI Studio)
GOOGLE_API_KEY=

# providers.nvidia (NVIDIA build)
NVIDIA_API_KEY=

# vllm-local and ollama run unauthenticated by default and need no key.

# Optional tool keys, read by name through each tool's env_allow (see
# docs/README.md, "Environment variables"). Web search runs without any of
# them, on DuckDuckGo with a Bing fallback; each one adds a source or lifts a
# rate limit. The alphaxiv tool is the exception: it needs its key.
# BRAVE_SEARCH_KEY=
# GOOGLE_SEARCH_KEY=             # Google Programmable Search, with the id below
# GOOGLE_SEARCH_CX=
# GITHUB_TOKEN=                  # GitHub search rate limit; also the gh_read tool
# ALPHAXIV_API_KEY=              # required by the alphaxiv tool

# Optional clanker process overrides (see docs/README.md):
# CLANKER_ENV_FILE=.env
# CLANKER_LOG_LEVEL=info
# CLANKER_HOST=127.0.0.1
# CLANKER_WEBUI_PORT=17921
# CLANKER_PROXY_PORT=17922
# CLANKER_PROXY_TOKEN=          # when [serve].proxy uses proxy_token_env
# CLANKER_THEME=mocha
# CLANKER_DEBUG_BODY=1          # logs request metadata only, never bodies
