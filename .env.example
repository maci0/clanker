# Copy to .env and fill in the keys for the providers you use (config.json
# "api_key_env"). clanker loads it automatically when modules.dotenv is on;
# real environment variables always take precedence over this file.
# Point CLANKER_ENV_FILE elsewhere to use a different path than ./.env.

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
META_AI_API_KEY=
OPENROUTER_API_KEY=
KIMI_API_KEY=

# vllm-local and ollama run unauthenticated by default and need no key.
