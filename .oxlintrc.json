{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Every rule runs at error across ui/, tools/ts/ and the scripts: the
  // Rika Labs strict preset (every builtin category, type-aware), the
  // vendored anti-slop plugin (tools/oxlint/anti-slop/, provenance in its
  // UPSTREAM.md) and @shadcn/lint over every class list passed through a
  // merge function (`cn` in ui/app/core/utils.js). Debt that predates this
  // config is recorded per file and rule in tools/oxlint/baseline.json;
  // `bun run lint` fails when any count rises above it or falls without the
  // baseline following (tools/oxlint/ratchet.ts).
  "options": { "typeAware": true },
  "extends": ["./node_modules/@rikalabs/oxlint-standards/presets/strict.json"],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" },
    "@rikalabs/oxlint-standards/plugin",
    "@shadcn/lint"
  ],
  "settings": {
    "shadcn": {
      "note": "The cabinet design system is DESIGN.md; tokens live in ui/app/tailwind.src.css."
    }
  },
  "rules": {
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "shadcn/no-arbitrary-values": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error",
    // The runner is `bun test`, whose supported API is node:test; these two
    // rules exist to move a suite onto the vitest runner this repo does not use.
    "vitest/no-import-node-test": "off",
    "vitest/prefer-importing-vitest-globals": "off",
    "no-console": "error",
    "no-empty-function": "error",
    "eqeqeq": "error",
    "no-duplicate-imports": "error",
    "no-useless-escape": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-empty-object-type": "error",
    "no-unused-vars": ["error", { "caughtErrors": "all", "caughtErrorsIgnorePattern": "^_", "varsIgnorePattern": "^_", "argsIgnorePattern": "^_", "destructuredArrayIgnorePattern": "^_" }],
    "no-unused-expressions": "error",
    "no-useless-empty-export": "error",
    "default-case": "error",
    "no-fallthrough": "error",
    "no-div-regex": "error",
    "no-document-cookie": "error",
    // Suppression hygiene: a blanket `oxlint-disable` (or an eslint spelling
    // of one) silences every rule on the line. `bun run lint` already fails a
    // disable directive that stopped matching anything. The tree has no
    // suppression comments, so this costs nothing today.
    "no-abusive-eslint-disable": "error",
    "array-callback-return": "error",
    "no-alert": "error",
    "no-caller": "error",
    "no-constructor-return": "error",
    "no-eval": "error",
    "no-extend-native": "error",
    "no-extra-bind": "error",
    "no-implied-eval": "error",
    "no-new-wrappers": "error",
    "no-proto": "error",
    "no-return-assign": "error",
    "no-script-url": "error",
    "no-self-compare": "error",
    "no-sequences": "error",
    "no-template-curly-in-string": "error",
    "no-throw-literal": "error",
    "no-unexpected-multiline": "error",
    "no-unmodified-loop-condition": "error",
    "no-unneeded-ternary": "error",
    "no-useless-concat": "error",
    "no-useless-constructor": "error",
    "preserve-caught-error": "error",
    "radix": "error",
    "import/no-duplicates": "error",
    "import/no-empty-named-blocks": "error",
    "import/no-self-import": "error",
    "import/no-webpack-loader-syntax": "error",
    "oxc/approx-constant": "error",
    "oxc/misrefactored-assign-op": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "unicorn/no-instanceof-builtins": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/require-module-specifiers": "error",
    "unicorn/require-post-message-target-origin": "error"
  },
  "globals": { "Bun": "readonly" },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "node_modules/**",
    "tools/ts/node_modules/**",
    "tools/ts/dist/**",
    "zig-out/**",
    "zig-cache/**",
    "zig-pkg/**",
    "ui/vendor/**",
    "vendor/**",
    "state/**",
    ".clanker-worktrees/**",
    ".zig-cache/**",
    ".scratch/**",
    ".local/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".playwright-mcp/**",
    "tools/oxlint/anti-slop/**",
    // AssemblyScript decorators (`@external`) not yet supported by oxlint's parser.
    "tools/ts/calc_ts.ts",
    "tools/ts/lib.ts"
  ],
  "overrides": [
    {
      "files": ["tools/ts/**/*.ts"],
      "rules": {
        "eqeqeq": "off",
        "no-console": "off"
      }
    },
    {
      "files": ["**/*.test.{js,mjs,ts}", "**/*.spec.{js,mjs,ts}", "tests/**/*", "ui/app/**/*.test.mjs", "ui/**/*.test.mjs", "tools/**/*.test.*"],
      "rules": {
        "no-console": "off",
        "no-empty-function": "off"
      }
    }
  ]
}
