{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  // Anti-slop: syntactic shortcuts that read as AI-generated filler and
  // survive `tsc`/`zig build` unnoticed. Rules whose count reached zero were
  // promoted to error and block CI; the rest are warn-level with a recorded
  // debt, so they stay visible without failing until paid down, then get the
  // same promotion (`npx oxlint --deny-warnings` previews the stricter gate).
  "rules": {
    "no-console": "error",
    "no-empty-function": "warn",
    // Loose equality is the classic LLM drift (`== null` vs `=== null`);
    // tools/ts AssemblyScript targets intentionally use `==` against
    // JKind discriminants so the override turns this off there.
    "eqeqeq": "warn",
    "no-duplicate-imports": "error",
    "no-useless-escape": "warn",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-empty-object-type": "error",
    // Warn, not error: the existing debt moves with every ui/ edit and would
    // make every run exit 1. Keep it as signal until paid, then promote back
    // to error; current count any time: `npx oxlint 2>&1 | grep -c 'warning '`.
    "no-unused-vars": ["warn", { "caughtErrors": "all", "caughtErrorsIgnorePattern": "^_", "varsIgnorePattern": "^_", "argsIgnorePattern": "^_", "destructuredArrayIgnorePattern": "^_" }],
    "no-unused-expressions": "warn",
    "no-useless-empty-export": "error",
    // Defect-class rules the tree already passes. Categories such as
    // suspicious/restriction still have unpaid hits, so they stay off as
    // groups; these individuals cannot regress without failing CI.
    "array-callback-return": "error",
    "no-alert": "error",
    "no-constructor-return": "error",
    "no-extend-native": "error",
    "no-extra-bind": "error",
    "no-new-wrappers": "error",
    "no-proto": "error",
    "no-return-assign": "error",
    "no-script-url": "error",
    "no-self-compare": "error",
    "no-sequences": "error",
    "no-template-curly-in-string": "error",
    "no-throw-literal": "error",
    "no-unexpected-multiline": "error",
    "no-unmodified-loop-condition": "error",
    "no-unneeded-ternary": "error",
    "no-useless-concat": "error",
    "no-useless-constructor": "error",
    "preserve-caught-error": "error",
    "radix": "error",
    "import/no-duplicates": "error",
    "import/no-empty-named-blocks": "error",
    "import/no-self-import": "error",
    "import/no-webpack-loader-syntax": "error",
    "oxc/approx-constant": "error",
    "oxc/misrefactored-assign-op": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "unicorn/no-instanceof-builtins": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/require-module-specifiers": "error",
    "unicorn/require-post-message-target-origin": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "node_modules/**",
    "tools/ts/node_modules/**",
    "tools/ts/dist/**",
    "zig-out/**",
    "zig-cache/**",
    "zig-pkg/**",
    "ui/vendor/**",
    "vendor/**",
    "state/**",
    ".clanker-worktrees/**",
    ".zig-cache/**",
    // AssemblyScript decorators (`@external`) not yet supported by oxlint's parser.
    "tools/ts/calc_ts.ts",
    "tools/ts/lib.ts"
  ],
  "overrides": [
    {
      "files": ["tools/ts/**/*.ts"],
      "rules": {
        "eqeqeq": "off",
        "no-console": "off"
      }
    },
    {
      "files": ["**/*.test.{js,mjs,ts}", "**/*.spec.{js,mjs,ts}", "tests/**/*", "ui/app/**/*.test.mjs", "ui/**/*.test.mjs", "tools/**/*.test.*"],
      "rules": {
        "no-console": "off",
        "no-empty-function": "off"
      }
    }
  ]
}
