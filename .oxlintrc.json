{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  // Anti-slop: syntactic shortcuts that read as AI-generated filler and
  // survive `tsc`/`zig build` unnoticed. Warnings print locally and in CI's
  // Lint JavaScript step without failing it; `npx oxlint --deny-warnings`
  // fails on them when you want the stricter gate.
  "rules": {
    "no-console": "warn",
    "no-empty-function": "warn",
    // Loose equality is the classic LLM drift (`== null` vs `=== null`);
    // tools/ts AssemblyScript targets intentionally use `==` against
    // JKind discriminants so the override turns this off there.
    "eqeqeq": "warn",
    "no-duplicate-imports": "warn",
    "no-useless-escape": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-non-null-asserted-optional-chain": "warn",
    "typescript/no-empty-object-type": "warn",
    // Warn, not error: the existing debt (202 hits when this landed, and
    // it moves with every ui/ edit) would make every run exit 1. Keep it
    // as signal until paid, then promote back to error; current count any
    // time: `npx oxlint 2>&1 | grep -c 'warning '`.
    "no-unused-vars": ["warn", { "caughtErrors": "all", "caughtErrorsIgnorePattern": "^_", "varsIgnorePattern": "^_", "argsIgnorePattern": "^_", "destructuredArrayIgnorePattern": "^_" }],
    "no-unused-expressions": "warn",
    "no-useless-empty-export": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "node_modules/**",
    "tools/ts/node_modules/**",
    "tools/ts/dist/**",
    "zig-out/**",
    "zig-cache/**",
    "zig-pkg/**",
    "ui/vendor/**",
    "vendor/**",
    "state/**",
    ".clanker-worktrees/**",
    ".zig-cache/**",
    // AssemblyScript decorators (`@external`) not yet supported by oxlint's parser.
    "tools/ts/calc_ts.ts",
    "tools/ts/lib.ts"
  ],
  "overrides": [
    {
      "files": ["tools/ts/**/*.ts"],
      "rules": {
        "eqeqeq": "off",
        "no-console": "off"
      }
    },
    {
      "files": ["**/*.test.{js,mjs,ts}", "**/*.spec.{js,mjs,ts}", "tests/**/*", "ui/app/**/*.test.mjs", "ui/**/*.test.mjs", "tools/**/*.test.*"],
      "rules": {
        "no-console": "off",
        "no-empty-function": "off"
      }
    }
  ]
}
