{
  "name": "win2k",
  "scheme": "light",
  "order": 110,
  "tokens": {
    "color-scheme": "light",
    "--paper": "#ffffff",
    "--bg": "#d4d0c8",
    "--surface": "#d4d0c8",
    "--surface-2": "#ffffff",
    "--surface-hover": "color-mix(in srgb, var(--fg) 8%, var(--surface))",
    "--surface-raised": "#d4d0c8",
    "--border": "#808080",
    "--rule": "#808080",
    "--fg": "#000000",
    "--fg-muted": "#404040",
    "--accent": "#0a246a",
    "--accent-dim": "#0a246a1f",
    "--accent-text": "#0a246a",
    "--on-accent": "#ffffff",
    "--ok": "#006400",
    "--ok-fill": "#006400",
    "--violet": "var(--accent)",
    "--violet-text": "var(--accent-text)",
    "--danger": "#a40000",
    "--on-danger": "#ffffff",
    "--scrim": "rgba(0, 0, 0, 0.5)",
    "--warn": "#6b5200",
    "--warn-text": "#6b5200",
    "--code-bg": "#ffffff",
    "--code-fg": "#000000",
    "--chat-hue-0": "#1c5898",
    "--chat-hue-1": "#903462",
    "--chat-hue-2": "#1f4a24",
    "--chat-hue-3": "#8c3f15",
    "--chat-hue-4": "#6a4983",
    "--chat-hue-5": "#3b5f24",
    "--chat-hue-6": "#a4281f",
    "--chat-hue-7": "#685400",
    "--lift-low": "1px 1px 0 rgba(64, 64, 64, 0.35)",
    "--lift": "2px 2px 3px rgba(0, 0, 0, 0.35)",
    "--lift-high": "2px 2px 6px rgba(0, 0, 0, 0.4)",
    "--bevel-raised": "inset -1px -1px 0 0 var(--sys-shadow), inset 1px 1px 0 0 var(--sys-light)",
    "--bevel-inset": "inset 1px 1px 0 0 var(--sys-dk-shadow), inset -1px -1px 0 0 var(--sys-light)",
    "--bevel-pressed": "inset 1px 1px 0 0 var(--sys-shadow)",

    "--sys-desktop": "#3a6ea5",
    "--sys-app-workspace": "#808080",
    "--sys-face": "#d4d0c8",
    "--sys-hilight": "#ffffff",
    "--sys-light": "#d4d0c8",
    "--sys-shadow": "#808080",
    "--sys-dk-shadow": "#404040",
    "--sys-alt-face": "#b5b5b5",
    "--sys-text": "#000000",
    "--sys-gray-text": "#808080",
    "--sys-window": "#ffffff",
    "--sys-window-text": "#000000",
    "--sys-frame": "#000000",
    "--sys-title": "#0a246a",
    "--sys-title-grad": "#a6caf0",
    "--sys-title-text": "#ffffff",
    "--sys-ititle": "#808080",
    "--sys-ititle-grad": "#c0c0c0",
    "--sys-ititle-text": "#d4d0c8",
    "--sys-active-border": "#d4d0c8",
    "--sys-inactive-border": "#d4d0c8",
    "--sys-sel": "#0a246a",
    "--sys-sel-text": "#ffffff",
    "--sys-hot": "#000080",
    "--sys-menu": "#d4d0c8",
    "--sys-menu-text": "#000000",
    "--sys-menu-hilight": "#000000",
    "--sys-info": "#ffffe1",
    "--sys-info-text": "#000000",
    "--sys-scrollbar": "#d4d0c8"
  }
