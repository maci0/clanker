{
  "name": "kanban",
  "description": "Internal: the whole Kanban operation surface behind one entry point, used by the web UI's /api/board. Agents use the kanban_* tools instead, which are the same wasm with one op each.",
  "wasm": "zig-out/tools/board.wasm",
  "internal": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "op": {
        "type": "string",
        "enum": ["list", "create", "add", "update", "move", "claim", "assign", "close", "delete", "log", "usage", "subtask_add", "subtask_toggle", "subtask_remove", "subtask_depend", "depend_add", "depend_remove"]
      },
      "room": {
        "type": "string",
        "description": "Board room name; omit for the default 'board' room"
      },
      "id": { "type": "string" },
      "title": { "type": "string" },
      "body": { "type": "string" },
      "column": { "type": "string" },
      "priority": { "type": "string" },
      "deadline": { "type": "integer" },
      "who": { "type": "string" },
      "assignee": { "type": "string" },
      "what": { "type": "string" },
      "subtask": { "type": "string" },
      "subtask_id": { "type": "string" },
      "parent_subtask_id": { "type": "string", "description": "Parent checklist item id for a nested subtask_add" },
      "text": { "type": "string" },
      "done": { "type": "boolean" },
      "on": { "type": "string" },
      "depends_on": { "type": "string" },
      "off": { "type": "boolean" },
      "prompt_tokens": { "type": "integer" },
      "completion_tokens": { "type": "integer" },
      "cost": { "type": "number" },
      "run": { "type": "string" },
      "run_id": { "type": "string" },
      "goal": { "type": "string", "description": "Goal id (state/goals.json) this card mirrors; empty string unlinks" },
      "completion_criterion": { "type": "string", "description": "Measurable completion criterion when this card is a goal" },
      "proof": { "type": "string", "description": "Test script or artifact that proves the criterion (path or command)" },
      "stop_rule": { "type": "string", "description": "When to abandon the goal attempt" },
      "boundaries": { "type": "string", "description": "What stays untouched" },
      "max_iterations": { "type": "integer", "description": "Per-goal iteration budget (1..1000)" },
      "worktree": { "type": "string", "description": "Git worktree (branch/path) this goal belongs to" },
      "labels": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "properties": { "color": { "type": "string" }, "text": { "type": "string" } },
          "required": ["color"]
        }
      }
    },
    "required": []
  },
  "fs_prefixes": [],
  "network_allow": [],
  "sequential": true,
  "category": "kanban"
}
