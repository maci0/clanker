{
  "name": "prompts",
  "description": "Saved prompt templates. Actions: list, create {title,content}, update {id,title?,content?}, delete {id}.",
  "input_schema": {
    "type": "object",
    "properties": {
      "action": { "type": "string", "enum": ["list", "create", "update", "delete"] },
      "id": { "type": "string" },
      "title": { "type": "string" },
      "content": { "type": "string" }
    }
  },
  "fs_prefixes": ["state/prompts.json"],
  "wasm": "zig-out/tools/prompts.wasm",
  "internal": true
}
