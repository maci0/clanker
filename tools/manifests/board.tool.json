{
  "name": "board",
  "description": "Internal: the whole board operation surface behind one entry point, used by the web UI's /api/board. Agents use the board_* tools instead, which are the same wasm with one op each.",
  "wasm": "zig-out/tools/board.wasm",
  "internal": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "op": {
        "type": "string",
        "enum": ["list", "create", "add", "update", "move", "claim", "assign", "close", "delete", "log", "usage", "subtask_add", "subtask_toggle", "subtask_remove", "depend_add", "depend_remove"]
      },
      "room": {
        "type": "string",
        "description": "Board room name; omit for the default 'board' room"
      },
      "id": { "type": "string" },
      "title": { "type": "string" },
      "body": { "type": "string" },
      "column": { "type": "string" },
      "priority": { "type": "string" },
      "deadline": { "type": "integer" },
      "who": { "type": "string" },
      "assignee": { "type": "string" },
      "what": { "type": "string" },
      "subtask": { "type": "string" },
      "subtask_id": { "type": "string" },
      "text": { "type": "string" },
      "done": { "type": "boolean" },
      "on": { "type": "string" },
      "depends_on": { "type": "string" },
      "off": { "type": "boolean" },
      "prompt_tokens": { "type": "integer" },
      "completion_tokens": { "type": "integer" },
      "cost": { "type": "number" },
      "run": { "type": "string" },
      "run_id": { "type": "string" },
      "goal": { "type": "string", "description": "Goal id (state/goals.json) this card mirrors; empty string unlinks" }
    },
    "required": []
  },
  "fs_prefixes": [],
  "network_allow": [],
  "sequential": true,
  "category": "board"
}
