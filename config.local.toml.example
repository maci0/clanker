# Checkout-private overrides: copy to config.local.toml (gitignored) and edit.
# Merged on top of config.toml key by key. Machine-specific endpoints, a
# different default_provider, or extra models belong here rather than in the
# committed config.toml.

# default_provider = "deepseek"

# A [providers.<name>] stanza here replaces the committed one whole, models
# included, so it has to bring its own: against the shipped config.toml, this
# stanza alone leaves vllm-local with no models and the load fails with
# "provider 'vllm-local': no models declared".
# [providers.vllm-local]
# base_url = "http://192.168.0.211:8000/v1"
# cache_ttl_ms = 0
#
# [models."vllm-local/deepseek-v4-flash"]
# provider = "vllm-local"
# context_window = 512000

# A model entry may also add to a provider only config.toml declares, with no
# [providers.<name>] stanza of its own:
# [models."deepseek/deepseek-chat"]
# provider = "deepseek"
# max_tokens = 2048

# [agent]
# max_iterations = 24

# [instance]
# name = "clanker-my-machine"
# id = "my-machine"
