{
  "default_provider": "kimi-k3",
  "providers": {
    "deepseek": {
      "kind": "openai_compat",
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY",
      "default_model": "deepseek-v4-flash",
      "models": {
        "deepseek-v4-flash": {
          "context_window": 1048576,
          "max_tokens": 8192,
          "temperature": 0.2,
          "reasoning_effort": "low",
          "cost_per_1m_input": 0.14,
          "cost_per_1m_output": 0.28
        },
        "deepseek-v4": {
          "context_window": 1048576,
          "max_tokens": 16384,
          "reasoning_effort": "medium",
          "cost_per_1m_input": 0.44,
          "cost_per_1m_output": 0.87,
          "temperature": 0.2
        }
      }
    },
    "openai": {
      "kind": "openai_compat",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "models": {
        "gpt-4o-mini": {
          "context_window": 128000,
          "temperature": 0.2
        }
      }
    },
    "vllm-local": {
      "kind": "openai_compat",
      "base_url": "http://192.168.0.211:8000/v1",
      "models": {
        "deepseek-v4-flash": {
          "context_window": 512000,
          "temperature": 0.2
        }
      }
    },
    "ollama": {
      "kind": "openai_compat",
      "base_url": "http://127.0.0.1:11434/v1",
      "models": {
        "qwen3.5": {
          "context_window": 32768,
          "temperature": 0.2
        }
      }
    },
    "anthropic": {
      "kind": "anthropic",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY",
      "models": {
        "claude-sonnet-5": {
          "context_window": 1000000
        }
      }
    },
    "muse-spark": {
      "kind": "openai_compat",
      "base_url": "https://api.meta.ai/v1",
      "api_key_env": "META_AI_API_KEY",
      "models": {
        "muse-spark-1.2-contributor": {
          "context_window": 1048576,
          "max_tokens": 16384,
          "temperature": 0.2
        }
      }
    },
    "muse-spark-1.1": {
      "kind": "openai_compat",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "models": {
        "meta/muse-spark-1.1": {
          "context_window": 163840,
          "max_tokens": 8192,
          "temperature": 0.2
        }
      }
    },
    "kimi-k3": {
      "kind": "openai_compat",
      "base_url": "https://api.moonshot.ai/v1",
      "api_key_env": "KIMI_API_KEY",
      "default_model": "kimi-k3",
      "models": {
        "kimi-k3": {
          "context_window": 1048576,
          "max_tokens": 16384,
          "reasoning_effort": "high",
          "cost_per_1m_input": 3.0,
          "cost_per_1m_output": 15.0,
          "temperature": 0.2,
          "display": "moonshotai/kimi-k3"
        },
        "kimi-k2.7-code": {
          "context_window": 262144,
          "max_tokens": 16384,
          "cost_per_1m_input": 0.7,
          "cost_per_1m_output": 3.5,
          "temperature": 0.2
        }
      }
    }
  },
  "agent": {
    "max_iterations": 24,
    "tools_dir": "tools/manifests",
    "skills_dir": "skills",
    "system_prompt_file": "skills/SYSTEM.md",
    "learnings_file": "state/learnings.md",
    "sandbox_root": ".",
    "seed": 0,
    "compact_threshold_bytes": 0,
    "git_remote_ops": false,
    "exec_pattern_allow": []
  },
  "instance": {
    "name": "clanker",
    "id": "main"
  },
  "modules": {
    "mcp": true,
    "peers": true,
    "a2a": true,
    "webui": true,
    "graphs": true,
    "sessions": true,
    "goal": true,
    "token_budget": true,
    "streaming": true,
    "dotenv": true,
    "chatrooms": true,
    "token_stats": true
  },
  "chatrooms": {
    "on": true,
    "rooms": [
      "dev"
    ],
    "max_history": 500
  }
}
